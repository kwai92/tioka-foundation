{
  "realm": "enterprise",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "foundation-admin",
      "name": "Foundation 服务账号（管理接口）",
      "description": "Foundation 经 client_credentials 调用 Keycloak Admin REST API；service account 持 realm-management/realm-admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "secret": "change-me-foundation-admin-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "service-account-foundation-admin",
      "enabled": true,
      "serviceAccountClientId": "foundation-admin",
      "clientRoles": {
        "realm-management": ["realm-admin"]
      }
    }
  ]
}
