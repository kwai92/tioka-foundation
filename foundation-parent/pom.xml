<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- PF-00a + 发布 pom 回归修复：**源码形态即发布形态的坐标基础**。
         本工程不再继承 foundation-build（BAS-23 明确该聚合器不对外发布），因此：
         ① 自身发布 pom 天然自包含，无需 <parent>remove</parent> 裁剪；
         ② 子模块发布 pom 保留 <parent> 指向本工程（已发布、零副作用），即可正常继承
            groupId 与 dependencyManagement 版本，不再出现「无 groupId + 依赖无 version」的无效模型；
         ③ 内部构建链（enforcer/failsafe/gate/distributionManagement）仍写在源码 pom，
            Foundation 子模块经 relativePath 读取时完整生效；对外发布 pom 由 flatten 裁掉这些元素，
            不污染下游业务系统。 -->
    <groupId>com.foundation</groupId>
    <artifactId>foundation-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>foundation-parent</name>
    <description>Foundation 父工程 —— 编译参数、格式与静态检查、依赖收敛、发布配置</description>

    <!-- 与 foundation-build 保持一致；下游业务系统继承发布 pom 时这些属性仍可解析。
         版本分轨：适配性剖面 0.2.0-adapt-SNAPSHOT，main 稳定基座 0.1.0-SNAPSHOT，见 docs/version-tracks.md。 -->
    <properties>
        <revision>0.2.0-adapt-SNAPSHOT</revision>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.2.12</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.foundation</groupId>
                <artifactId>foundation-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <!-- 保留参数名：Spring 绑定与 -parameters 约定 -->
                        <parameters>true</parameters>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <!-- 时间统一 UTC（00-施工总纲 §2.2）；*IT 默认不进单元测试 -->
                        <argLine>-Dnet.bytebuddy.experimental=true -Duser.timezone=UTC</argLine>
                        <excludedGroups>gate</excludedGroups>
                        <runOrder>random</runOrder>
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <argLine>-Dnet.bytebuddy.experimental=true -Duser.timezone=UTC</argLine>
                        <excludedGroups>gate</excludedGroups>
                        <runOrder>random</runOrder>
                    </configuration>
                    <executions>
                        <execution>
                            <id>integration-test</id>
                            <goals>
                                <goal>integration-test</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>verify</id>
                            <goals>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 内部构建链（源码 pom）与对外发布形态（flattened pom）分离：
                 裁剪 distributionManagement / profiles / 实际执行的 plugins，仅保留
                 pluginManagement 插件版本契约。**不裁剪 parent** —— 本工程自身已无父，
                 而子模块必须保留 parent 才能继承 groupId 与 BOM 版本。
                 下游（Tioka 及其它业务系统）继承本父工程时：不依赖未发布的聚合器、
                 不改写自身发布目标、不被 Foundation 的 enforcer/failsafe 执行与 gate profile 污染。
                 验收：示例工程只引父工程可编译（F-01 §3）；裸工程只引子模块可解析传递依赖。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <!-- 本工程已不继承 foundation-build，须自行声明插件版本与执行绑定。 -->
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <pomElements>
                        <distributionManagement>remove</distributionManagement>
                        <profiles>remove</profiles>
                        <build>remove</build>
                    </pomElements>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!-- 集成测试：*IT 由 failsafe 执行（-DskipITs 可跳过，闸门用例见 gate profile） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>extra-enforcer-rules</artifactId>
                        <version>1.8.0</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>enforce-java-and-deps</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- 约束 1：Java 版本 -->
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                </requireJavaVersion>
                                <!-- 约束 2：禁止 Maven 模块循环依赖 -->
                                <banCircularDependencies/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>foundation-private</id>
            <name>Foundation Private Repository</name>
            <url>${env.FOUNDATION_REPO_URL}</url>
        </repository>
        <snapshotRepository>
            <id>foundation-private</id>
            <name>Foundation Private Snapshot Repository</name>
            <url>${env.FOUNDATION_REPO_URL}</url>
        </snapshotRepository>
    </distributionManagement>

    <!-- 闸门流水线：默认 verify 排除 @Tag("gate")，本 profile 只跑 gate（GF 闸门用例） -->
    <profiles>
        <profile>
            <id>gate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <argLine>-Dnet.bytebuddy.experimental=true -Duser.timezone=UTC -Dgate=true</argLine>
                            <groups>gate</groups>
                            <excludedGroups combine.self="override"/>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <excludes combine.self="override"/>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <!-- gate 用例已由 surefire（-Pgate 含 *IT）执行 -->
                            <skipITs>true</skipITs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
