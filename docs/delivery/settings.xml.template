<?xml version="1.0" encoding="UTF-8"?>
<!--
  ADP-12：私有 Maven 仓库凭据模板。
  用法：复制为 ~/.m2/settings.xml（或合并到已有 settings.xml 的 <servers> 节点）。
  凭据一律从环境变量读取，绝不写进仓库或 CI 日志。
  server id 必须与 foundation-parent/pom.xml 的 distributionManagement 一致：foundation-private。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>foundation-private</id>
      <username>${env.FOUNDATION_REPO_USER}</username>
      <password>${env.FOUNDATION_REPO_TOKEN}</password>
    </server>
  </servers>
</settings>
