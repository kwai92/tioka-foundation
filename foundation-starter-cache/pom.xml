<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.foundation</groupId>
        <artifactId>foundation-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../foundation-parent/pom.xml</relativePath>
    </parent>

    <artifactId>foundation-starter-cache</artifactId>
    <name>foundation-starter-cache</name>
    <description>缓存约定：Redis/Redisson 装配、键前缀、分布式锁、限流（F-02 BAS-24）</description>

    <!-- 只依赖 foundation-starter-core（S15 §5.2 依赖约束） -->
    <dependencies>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Redisson 内核：装配分布式锁与限流；未引入时退化为单实例实现 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
