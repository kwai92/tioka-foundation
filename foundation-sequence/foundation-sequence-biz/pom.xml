<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.foundation</groupId>
        <artifactId>foundation-sequence</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>foundation-sequence-biz</artifactId>
    <name>foundation-sequence-biz</name>
    <description>编号与序列实现（F-09 BAS-18 §18.2：规则管理、原子取号、模式渲染与校验位、按周期重置）</description>

    <dependencies>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-sequence-api</artifactId>
        </dependency>
        <!-- 跨模块只依赖对方 -api：错误码与共享工具取自 common-api -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-common-api</artifactId>
        </dependency>
        <!-- 权限注解与当前用户（@RequirePermission / PrincipalHolder） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-security</artifactId>
        </dependency>
        <!-- 关键写操作的审计上报（@Audited） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- REST 层：Controller -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 持久化：48-CS §4「ORM 仅 MyBatis-Plus」，统一经 starter 装配 -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-data</artifactId>
        </dependency>
        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
