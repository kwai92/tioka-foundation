<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.foundation</groupId>
        <artifactId>foundation-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../foundation-parent/pom.xml</relativePath>
    </parent>

    <artifactId>foundation-starter-mq</artifactId>
    <name>foundation-starter-mq</name>
    <description>消息封装：领域事件、outbox 与中继、消费幂等、死信约定（F-02 BAS-24）</description>

    <!-- 生产只依赖 foundation-starter-core（S15 §5.2 依赖约束）；下方 test scope 依赖不对外传递 -->
    <dependencies>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-core</artifactId>
        </dependency>
        <!-- RocketMQ 客户端；未引入时退化为日志投递（本地/单测可用） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- outbox / 消费幂等表按 48-CS §4 只用 MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            MqOutboxIT 轻装配上下文需要平台的 TIMESTAMPTZ ↔ LocalDateTime 桥接
            （starter-data 的 UtcLocalDateTimeTypeHandler）。生产环境由宿主应用提供
            SqlSessionFactory（如 foundation-server 依赖 starter-data），故本模块生产不需要它；
            此处 test scope 只为复用平台资产，避免同一语义在测试里再实现一份（判据②）。
        -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-data</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MqOutboxIT：PostgreSQL 容器与轻装配 -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
