<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.foundation</groupId>
    <artifactId>foundation-build</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>Foundation Build</name>
    <description>Tioka Foundation 工程底座 —— 聚合构建（聚合器，不对外发布）</description>

    <modules>
        <module>foundation-dependencies</module>
        <module>foundation-parent</module>
        <module>foundation-common</module>
        <module>foundation-starter-core</module>
        <module>foundation-starter-data</module>
        <module>foundation-starter-security</module>
        <module>foundation-starter-audit</module>
        <module>foundation-starter-client</module>
        <module>foundation-app</module>
        <module>foundation-authz</module>
        <module>foundation-org</module>
        <module>foundation-test</module>
        <module>foundation-server</module>
        <module>foundation-it-example</module>
    </modules>

    <properties>
        <revision>0.1.0-SNAPSHOT</revision>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.2.12</spring-boot.version>
    </properties>

    <build>
        <plugins>
            <!-- 全模块继承：把 ${revision} 在安装/发布时固化为具体版本 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
