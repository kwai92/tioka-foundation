<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.foundation</groupId>
        <artifactId>foundation-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../foundation-parent/pom.xml</relativePath>
    </parent>

    <artifactId>foundation-starter-observability</artifactId>
    <name>foundation-starter-observability</name>
    <description>可观测约定：OpenTelemetry 与采样、traceId 透传、健康检查（对齐 GOV-08，F-02 BAS-24）</description>

    <!-- 只依赖 foundation-starter-core（S15 §5.2 依赖约束） -->
    <dependencies>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-core</artifactId>
        </dependency>
        <!-- javaagent 提供 SDK；应用侧只需 API -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
