<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.foundation</groupId>
        <artifactId>foundation-file</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>foundation-file-biz</artifactId>
    <name>foundation-file-biz</name>
    <description>文件服务实现（F-09 BAS-17：存储抽象、分片、预签名 URL、病毒扫描挂点、按应用隔离）</description>

    <dependencies>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-file-api</artifactId>
        </dependency>
        <!-- 跨模块只依赖对方 -api：错误码与共享工具取自 common-api -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-common-api</artifactId>
        </dependency>
        <!-- 权限注解与当前用户（@RequirePermission / PrincipalHolder） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-security</artifactId>
        </dependency>
        <!-- 关键写操作与流式下载的审计上报（@Audited） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- REST 层：Controller 与 multipart 上传 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 持久化：48-CS §4「ORM 仅 MyBatis-Plus」，统一经 starter 装配（含 BaseDO 审计基类） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-data</artifactId>
        </dependency>
        <!-- 对象存储出站：S3 兼容（MinIO / 客户 OSS）签名与调用复用 okhttp，不引入重型 SDK -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
