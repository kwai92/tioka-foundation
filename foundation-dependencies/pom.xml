<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.foundation</groupId>
        <artifactId>foundation-build</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>foundation-dependencies</artifactId>
    <packaging>pom</packaging>
    <name>foundation-dependencies</name>
    <description>Foundation BOM —— 统一版本清单（只做 dependencyManagement，不引入依赖）</description>

    <properties>
        <spring-boot.version>3.2.12</spring-boot.version>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <archunit.version>1.3.0</archunit.version>
        <ulid-creator.version>5.2.3</ulid-creator.version>
        <rocketmq-spring.version>2.3.1</rocketmq-spring.version>
        <redisson.version>3.37.0</redisson.version>
        <hutool.version>5.8.34</hutool.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc.version>2.6.0</springdoc.version>
        <opentelemetry.version>1.43.0</opentelemetry.version>
        <okhttp.version>4.12.0</okhttp.version>
        <!-- Boot 3.2 自带 1.19.x 连不上较新的 Docker（最低 API 1.44）；1.21.4 起兼容 -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <testcontainers-keycloak.version>3.3.0</testcontainers-keycloak.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 必须在 spring-boot-dependencies 之前导入，才能覆盖其中的 Testcontainers 版本 -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Foundation 自有构件（随各工作项追加；此处仅登记已存在的两项） -->
            <dependency>
                <groupId>com.foundation</groupId>
                <artifactId>foundation-parent</artifactId>
                <version>${revision}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>com.foundation</groupId>
                <artifactId>foundation-common-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.foundation</groupId>
                <artifactId>foundation-common-biz</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.foundation</groupId>
                <artifactId>foundation-starter-data</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.foundation</groupId>
                <artifactId>foundation-app-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.foundation</groupId>
                <artifactId>foundation-app-biz</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.foundation</groupId>
                <artifactId>foundation-authz-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.foundation</groupId>
                <artifactId>foundation-authz-biz</artifactId>
                <version>${revision}</version>
            </dependency>
            <!-- 测试基座：不进生产依赖（F-00 §5 约定） -->
            <dependency>
                <groupId>com.foundation</groupId>
                <artifactId>foundation-test</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.foundation</groupId>
                <artifactId>foundation-it-example</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.f4b6a3</groupId>
                <artifactId>ulid-creator</artifactId>
                <version>${ulid-creator.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq-spring.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>mockwebserver</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <!-- 闸门基座：Keycloak 容器（S15 §14.1，GF 闸门共用） -->
            <dependency>
                <groupId>com.github.dasniko</groupId>
                <artifactId>testcontainers-keycloak</artifactId>
                <version>${testcontainers-keycloak.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
