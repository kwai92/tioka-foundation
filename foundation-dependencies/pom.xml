<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 与 foundation-parent 一致：BOM 也解除对未发布聚合器 foundation-build 的继承，
         避免安装产物带 <parent> 指向下游无法解析的构件。坐标与 revision 因此显式写出。 -->
    <groupId>com.foundation</groupId>
    <artifactId>foundation-dependencies</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>foundation-dependencies</name>
    <description>Foundation BOM —— 统一版本清单（只做 dependencyManagement，不引入依赖）</description>

    <properties>
        <!-- 版本分轨：BOM 管理的 com.foundation:* 版本必须随适配性剖面走，见 docs/version-tracks.md。 -->
        <revision>0.2.0-adapt-SNAPSHOT</revision>
        <spring-boot.version>3.2.12</spring-boot.version>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <archunit.version>1.3.0</archunit.version>
        <ulid-creator.version>5.2.3</ulid-creator.version>
        <rocketmq-spring.version>2.3.1</rocketmq-spring.version>
        <redisson.version>3.37.0</redisson.version>
        <hutool.version>5.8.34</hutool.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc.version>2.6.0</springdoc.version>
        <opentelemetry.version>1.43.0</opentelemetry.version>
        <okhttp.version>4.12.0</okhttp.version>
        <nimbus-jose-jwt.version>9.37.3</nimbus-jose-jwt.version>
        <!-- 组织人员 Excel 导入导出（F-03 BAS-02 §4） -->
        <poi.version>5.2.5</poi.version>
        <!-- Boot 3.2 自带 1.19.x 连不上较新的 Docker（最低 API 1.44）；1.21.4 起兼容 -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <testcontainers-keycloak.version>3.3.0</testcontainers-keycloak.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 必须在 spring-boot-dependencies 之前导入，才能覆盖其中的 Testcontainers 版本 -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Foundation 自有构件（随各工作项追加；此处仅登记已存在的两项） -->
            <dependency>
