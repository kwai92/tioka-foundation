<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.foundation</groupId>
        <artifactId>foundation-audit</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>foundation-audit-biz</artifactId>
    <name>foundation-audit-biz</name>
    <description>审计与登录日志实现（F-09 BAS-10：上报幂等、查询、导出、链封印、分区归档、登录事件采集）</description>

    <dependencies>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-audit-api</artifactId>
        </dependency>
        <!-- 跨模块只依赖对方 -api：错误码、事件契约、ID 生成取自 common-api -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-common-api</artifactId>
        </dependency>
        <!-- 登录事件回填 last_login_at -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-account-api</artifactId>
        </dependency>
        <!-- 权限注解与当前用户（@RequirePermission / PrincipalHolder / AuthzSnapshot） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- REST 层：Controller 与请求体 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 持久化：48-CS §4「ORM 仅 MyBatis-Plus」，统一经 starter 装配 -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-data</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
