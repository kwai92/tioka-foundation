      "sort": 1,
      "visible": true,
      "permissionCode": "{app}:example:admin"
    }
  ],
  "permissions": [
    {
      "code": "{app}:example:read",
      "name": "示例读取",
      "riskLevel": "LOW"
    },
    {
      "code": "{app}:example:admin",
      "name": "示例管理",
      "riskLevel": "MEDIUM"
    }
  ]
}
