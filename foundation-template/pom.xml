<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      BAS-25 工程模板聚合器（复制起点，不是代码生成器）。
      占位符 {app} 会同时出现在目录名、文件名与文件内容中，由 scripts/rename.* 统一替换为新应用编码。
      parent 从仓库解析（foundation-parent 已发布到私有仓），故使用空 <relativePath/>
      —— 本模板刻意不加入 tioka-foundation 根 pom.xml 的 <modules>。
    -->
    <parent>
        <groupId>com.foundation</groupId>
        <artifactId>foundation-parent</artifactId>
        <!-- 模板随适配性剖面发布，parent 必须指向对应版本轨；新业务项目改用稳定基座时改成 0.1.0-SNAPSHOT，
             见 docs/version-tracks.md。下方 <version> 自身版本是新应用坐标，与 Foundation 版本无关。 -->
        <version>0.2.0-adapt-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>{app}</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>{app}</name>
    <description>{app} 子系统（BAS-25 模板复制生成）：示例 api/biz 分层与跨模块只依赖 -api</description>

    <modules>
        <module>{app}-server</module>
        <module>{app}-example-api</module>
        <module>{app}-example-biz</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- 刻意不声明任何依赖版本：版本全部来自 foundation-parent → foundation-dependencies -->
</project>
