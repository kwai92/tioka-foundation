<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.foundation</groupId>
        <artifactId>foundation-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../foundation-parent/pom.xml</relativePath>
    </parent>

    <artifactId>foundation-server</artifactId>
    <name>foundation-server</name>
    <description>Foundation 服务装配：Spring Boot 应用、Flyway 迁移与运行配置</description>

    <dependencies>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-common-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-app-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-org-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-account-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-authz-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-notify-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-audit-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-file-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-calendar-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-sequence-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-auth-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-sync-biz</artifactId>
        </dependency>
        <!-- 内置同步适配器（F-08 BAS-12）：飞书通讯录、LDAP/AD；经 BAS-11 同步接口登记与触发，不自建 REST -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-sync-adapter-feishu</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-sync-adapter-ldap</artifactId>
        </dependency>
        <!-- 持久化装配（MyBatis-Plus + 审计填充 + MapperScan） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-data</artifactId>
        </dependency>
        <!-- 权限注解与主体上下文（@RequirePermission / PrincipalHolder） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-security</artifactId>
        </dependency>
        <!-- Web 装配（异常映射、幂等键、脱敏序列化等） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-web</artifactId>
        </dependency>
        <!-- 事件发布：outbox 表写入与中继（F-05 §4；common-biz 的 outbox 依赖其 appender） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-mq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 存活/就绪探针（BAS-21 §3.10：/actuator/health/liveness、/actuator/health/readiness） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
