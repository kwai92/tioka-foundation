<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.foundation</groupId>
        <artifactId>foundation-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../foundation-parent/pom.xml</relativePath>
    </parent>

    <artifactId>foundation-server</artifactId>
    <name>foundation-server</name>
    <description>Foundation 服务装配：Spring Boot 应用、Flyway 迁移与运行配置</description>

    <dependencies>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-common-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-app-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-org-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-account-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-authz-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-notify-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-audit-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-file-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-calendar-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-sequence-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-auth-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-sync-biz</artifactId>
        </dependency>
        <!-- 内置同步适配器（F-08 BAS-12）：飞书通讯录、LDAP/AD；经 BAS-11 同步接口登记与触发，不自建 REST -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-sync-adapter-feishu</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-sync-adapter-ldap</artifactId>
        </dependency>
        <!-- 持久化装配（MyBatis-Plus + 审计填充 + MapperScan） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-data</artifactId>
        </dependency>
        <!-- 权限注解与主体上下文（@RequirePermission / PrincipalHolder） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-security</artifactId>
        </dependency>
        <!-- Web 装配（异常映射、幂等键、脱敏序列化等） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-web</artifactId>
        </dependency>
        <!-- 事件发布：outbox 表写入与中继（F-05 §4；common-biz 的 outbox 依赖其 appender） -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-mq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 存活/就绪探针（BAS-21 §3.10：/actuator/health/liveness、/actuator/health/readiness） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- 必须显式声明 repackage：foundation-parent 的 pluginManagement 只锁版本、
                     且本工程的父不是 spring-boot-starter-parent（无默认 execution 绑定），
                     缺此配置时产出的是 47KB 普通 jar（无 BOOT-INF / Main-Class），
                     deploy/Dockerfile.foundation 的 `java -jar /app/app.jar` 无法启动，
                     deploy/compose.yml 的「空环境一条命令起全套」会在本服务失败。 -->
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.foundation.server.FoundationApplication</mainClass>
                            <!--
                                classifier 是**必需**的，不要删：不配 classifier 时 repackage 会
                                「Replacing main artifact」，把 target/foundation-server-*.jar 原地换成
                                fat jar（classes 移入 BOOT-INF/classes/）。而 failsafe 在 verify 阶段
                                （晚于 package）用 **project 主 artifact** 构造 test classpath，于是
                                SpringBootTestContextBootstrapper 从测试包向上扫描时找不到
                                @SpringBootApplication，本模块全部 IT 报
                                「Unable to find a @SpringBootConfiguration」而失败，连带 gate job 的
                                GfSmokeIT / GF 闸门一起挂。
                                配 classifier 后：主 artifact 保持普通 jar（IT 可用），
                                fat jar 另出为 foundation-server-*-exec.jar（部署用，见
                                deploy/Dockerfile.foundation）。
                                CI 实证：failsafe 的 classpath 首项是 foundation-server-0.2.0-SNAPSHOT.jar
                                而非 classes 目录，surefire 阶段则用 classes 目录——这解释了为何
                                单测全绿、只有 IT 失败。
                            -->
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
